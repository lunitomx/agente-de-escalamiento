#!/usr/bin/env python3
"""Run the ScaleUp natural-language router with a fixed, auditable entrypoint."""

from __future__ import annotations

import json
import sys
from pathlib import Path


def runtime_root() -> Path:
    """Locate the checkout or installed ScaleUp runtime that owns this command."""
    here = Path(__file__).resolve()
    for candidate in (here.parent.parent, *here.parents):
        if (candidate / "coaching" / "router" / "__init__.py").is_file():
            return candidate
    raise RuntimeError("No se encontró el runtime de ScaleUp")


HANDOFFS = {
    "welcome": "coaching.welcome",
    "diagnose": "coaching.diagnose",
    "opsp": "coaching.opsp",
    "progress": "coaching.progress",
}


def _context(payload: str) -> dict:
    try:
        value = json.loads(payload)
    except json.JSONDecodeError as error:
        raise ValueError("El contexto debe ser JSON válido") from error
    if not isinstance(value, dict):
        raise TypeError("El contexto debe ser un objeto JSON")
    value["base_path"] = "."
    return value


def _reconcile_memory() -> None:
    """Silently import allowlisted legacy business sources when they exist."""
    try:
        from escala_server.project_memory_migration import ProjectMemoryMigrator

        migrator = ProjectMemoryMigrator(Path.cwd())
        if migrator.has_migratable_sources():
            migrator.migrate()
    except (OSError, ValueError):
        pass


def _run_handoff(action: str, payload: str) -> int:
    from importlib import import_module

    _reconcile_memory()
    try:
        result = import_module(HANDOFFS[action]).run(_context(payload))
    finally:
        _reconcile_memory()
    print(json.dumps(result, ensure_ascii=False))
    return 0


def _validate_opsp(path: str) -> int:
    from coaching.opsp import validate_opsp

    errors = validate_opsp(Path(path))
    print(json.dumps({"valid": not errors, "errors": errors}, ensure_ascii=False))
    return 0


def _conversation(message: str) -> int:
    """Run the fixed stateful public conversation; no caller supplied JSON."""
    from coaching.router.conversation import run

    _reconcile_memory()
    try:
        response = run(message, base_path=".")
    finally:
        _reconcile_memory()
    print(response)
    return 0


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1].strip():
        return _conversation(sys.argv[1])

    if len(sys.argv) == 3 and sys.argv[1] == "conversation" and sys.argv[2].strip():
        return _conversation(sys.argv[2])

    if len(sys.argv) == 4 and sys.argv[1] == "run" and sys.argv[2] in HANDOFFS:
        return _run_handoff(sys.argv[2], sys.argv[3])

    if len(sys.argv) == 3 and sys.argv[1] == "validate-opsp":
        return _validate_opsp(sys.argv[2])

    print(
        "Uso interno: scaleup-frontdoor MENSAJE | conversation MENSAJE | run {welcome|diagnose|opsp|progress} JSON | validate-opsp RUTA",
        file=sys.stderr,
    )
    return 2


if __name__ == "__main__":
    sys.path.insert(0, str(runtime_root()))
    raise SystemExit(main())
